* {
    base: #090b10;
    surface: #0f121ad1;
    surface-strong: #161b26eb;
    border: #94a3b82e;
    text: #f8fafc;
    muted: #94a3b8;
    accent: #38bdf8;
    accent-soft: #38bdf82e;
    critical: #ef4444;

    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 13";
}

window {
    width: 520px;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    background-color: @surface;
    padding: 14px;
}

mainbox {
    spacing: 14px;
    background-color: transparent;
}

inputbar {
    spacing: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    background-color: @surface-strong;
    text-color: @text;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 13";
}

entry {
    placeholder: "Search apps";
    placeholder-color: @muted;
    text-color: @text;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 6px;
    background-color: transparent;
}

element {
    padding: 10px 12px;
    border-radius: 12px;
    background-color: transparent;
    text-color: @muted;
}

element selected {
    background-color: @accent-soft;
    text-color: @text;
}

element-icon {
    size: 22px;
    margin: 0 10px 0 0;
}

element-text {
    text-color: @text;
}

message {
    padding: 10px 12px;
    border-radius: 12px;
    background-color: @surface-strong;
}

textbox {
    text-color: @muted;
}
