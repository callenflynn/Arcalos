configuration {
    modi: "drun,window";
    show-icons: true;
    display-drun: "Spotlight";
    display-window: "Windows";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 13";
    hover-select: false;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@theme "arcalos"
