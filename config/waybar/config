{
  "layer": "top",
  "position": "top",
  "height": 32,

  "modules-left": ["hyprland/workspaces"],

  "modules-center": ["clock"],

  "modules-right": [
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "tray"
  ],

  "clock": {
    "format": "{:%a %b %d  %H:%M}"
  },

  "pulseaudio": {
    "format": " {volume}%"
  },

  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "󰈀"
  },

  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": " {percentage}%"
  }
}
